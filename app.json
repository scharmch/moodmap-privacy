{
  "expo": {
    "privacyPolicyUrl": "https://moodmap.app/privacy",
    "name": "MoodMap AI",
    "slug": "moodmap-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4A90D9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moodmap.app",
      "buildNumber": "1",
      "icon": "./assets/images/icon.png",
      "appleTeamId": "REPLACE_WITH_YOUR_TEAM_ID",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Allow Emotional GPS to access your location to track where you feel your best.",
        "NSMicrophoneUsageDescription": "MoodMap AI uses the microphone to record voice notes for your emotional check-ins.",
        "NSSpeechRecognitionUsageDescription": "MoodMap AI uses speech recognition to transcribe your voice notes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#4A90D9"
      },
      "package": "com.moodmap.app",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_CALL_LOG"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "expo-audio",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Emotional GPS to access your location to track where you feel your best.",
          "locationWhenInUsePermission": "Allow Emotional GPS to access your location to track where you feel your best."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#4A90D9"
        }
      ]
    ],
    "scheme": "moodmapai",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "privacyPolicyUrl": "https://moodmap.app/privacy"
    }
  }
}